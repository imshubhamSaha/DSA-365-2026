#Number of Valid Parentheses

class Solution:
    def findWays(self, n):
        if n % 2 == 1:
            return 0
        def is_valid(s) :
            balanced_parenthesis = 0
            for brac in s :
                if brac == "(" :
                    balanced_parenthesis += 1
                else :
                    balanced_parenthesis -= 1
                if balanced_parenthesis < 0 :
                    return False
            
            return balanced_parenthesis == 0 
            
        valid_parenthesis_count = 0
        
        def generate_parenthesis(curr) :
            nonlocal valid_parenthesis_count
            if len(curr) == n :
                if (is_valid(curr)) :
                    valid_parenthesis_count += 1
                return
            generate_parenthesis(curr + '(')
            generate_parenthesis(curr + ')')
            
        generate_parenthesis('')
        return valid_parenthesis_count


Time:O(2^n * n)
Space : O(n)


class Solution:
    def findWays(self, n):
        if n % 2 == 1:
            return 0

        k = n // 2
        number_of_parenthesis = 1

        for i in range(1, k + 1):
            number_of_parenthesis = number_of_parenthesis * 2 * (2*i - 1) // (i + 1)

        return number_of_parenthesis
        
Time:O( n)
Space : O(1)
