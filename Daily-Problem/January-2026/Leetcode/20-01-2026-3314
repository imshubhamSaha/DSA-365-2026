//3314. Construct the Minimum Bitwise Array I

/**
 * @param {number[]} nums
 * @return {number[]}
 */
var minBitwiseArray = function (nums) {
  const n = nums.length;
  const answer = new Array(n).fill(-1);

  for (let i = 0; i < n; i++) {
    let idx = 0;
    while (idx < nums[i]) {
      if ((idx | (idx + 1)) === nums[i]) {
        answer[i] = idx;
        break;
      }
      idx += 1;
    }
  }
  return answer;
};
