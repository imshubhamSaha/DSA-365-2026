#1200. Minimum Absolute Difference
class Solution:
    def minimumAbsDifference(self, arr: List[int]) -> List[List[int]]:
        n = len(arr)
        arr.sort()

        diff = float('inf')
        for i in range(1, n):
            diff = min(diff, arr[i] - arr[i - 1])

        res = []
        for i in range(1, n):
            if arr[i] - arr[i - 1] == diff:
                res.append([arr[i - 1], arr[i]])

        return res
